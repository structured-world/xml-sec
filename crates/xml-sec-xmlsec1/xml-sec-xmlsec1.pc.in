prefix=@prefix@
libdir=@libdir@
includedir=@includedir@

Name: xml-sec-xmlsec1
Description: libxmlsec1-compatible C interface over the xml-sec core
Version: 1.3.13
Requires: libxml-2.0
Cflags: -DXMLSEC_CRYPTO_DYNAMIC_LOADING=1 -D__XMLSEC_FUNCTION__=__func__ -DXMLSEC_NO_XSLT=1 -DXMLSEC_NO_FTP=1 -DXMLSEC_NO_HTTP=1 -DXMLSEC_NO_GOST=1 -DXMLSEC_NO_GOST2012=1 -DXMLSEC_NO_MLDSA=1 -DXMLSEC_NO_SLHDSA=1 -I${includedir}
Libs: -L${libdir} -lxml_sec_xmlsec1
