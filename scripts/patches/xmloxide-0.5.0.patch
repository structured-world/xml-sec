+        assert!(needed > SOURCE.len());
+        assert_eq!(run(1 << 20, 0, 1 << 24).0, Some(MemoryError::WorkExceeded));
+        assert_eq!(run(1 << 20, 1 << 24, 0).0, Some(MemoryError::WorkExceeded));
+        assert_eq!(run(0, 1 << 24, 1 << 24).0, Some(MemoryError::LimitExceeded));
