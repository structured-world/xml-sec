+    /// the stored low-order bits or public-key hash do not match the secret key.
+    pub fn try_from_expanded(enc: &ExpandedSigningKeyBytes<P>) -> Result<Self, Error> {
+        let (rho, K, tr, s1_enc, s2_enc, t0_enc) = P::split_sk(enc);
