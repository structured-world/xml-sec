# Signed input and captured oracle bytes must survive checkout byte-for-byte.
# Trailing spaces in signed XML are evidence, not source lint.
fixtures/** -text -whitespace linguist-generated
*.bin -text -diff -whitespace linguist-generated
*.der -text -diff -whitespace linguist-generated
# Collapse generated evidence during review while keeping selection and prose visible.
results/** linguist-generated
dss-evidence/** linguist-generated
dss-investigation/*/** -text -whitespace linguist-generated
SHA256SUMS linguist-generated
